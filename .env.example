# =============================================================================
# StudyTrack — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored and blocked by pre-commit. NEVER commit real secrets.
# =============================================================================

# --- Postgres (consumed by docker-compose.yml dev service) -------------------
POSTGRES_USER=studytrack
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_DB=studytrack
# Host port to expose the dev DB on (change if 5432 is taken locally).
POSTGRES_PORT=5432

# --- Backend (FastAPI + SQLAlchemy) ------------------------------------------
# SQLAlchemy URL (sync psycopg driver — matches the backend engine). Use
# host=localhost when the BE runs on the host against the docker-compose db;
# use host=db when the BE runs inside compose (prod).
DATABASE_URL=postgresql+psycopg://studytrack:change-me-in-real-env@localhost:5432/studytrack

# Secret used to sign JWT access tokens. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# Background reminder scanner interval, in seconds (Phase 5 realtime). Optional;
# the backend default is 60. Lower it for snappier deadline reminders.
# REMINDER_SCAN_SECONDS=60

# --- Email (Phase 6) ---------------------------------------------------------
# Delivery backend for account emails (verify / password reset):
#   console = log the link to stdout (dev default, no real delivery)
#   smtp    = send via the stdlib smtplib using the EMAIL_SMTP_* settings below
EMAIL_BACKEND=console            # console | smtp
EMAIL_FROM="StudyTrack <no-reply@studytrack.app>"
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
# Public base URL of the frontend, used to build verify/reset links in emails.
FRONTEND_URL=http://localhost:5173
# Single-use token lifetimes (hours).
EMAIL_VERIFY_TTL_HOURS=48
PASSWORD_RESET_TTL_HOURS=1

# --- Rate limiting (Phase 6) -------------------------------------------------
# slowapi throttling on public auth endpoints. Disabled automatically in tests.
RATE_LIMIT_ENABLED=true

# --- Frontend (Vite) ---------------------------------------------------------
# Base URL the SPA calls. Dev points at the local backend; prod points at the
# public domain behind nginx (e.g. https://studytrack.example.com/api).
VITE_API_URL=http://localhost:8000

# --- Optional / later phases -------------------------------------------------
# Anthropic API key for the AI study-suggestion feature (uncomment when wired).
# ANTHROPIC_API_KEY=sk-ant-...
