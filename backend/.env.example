# Copy to .env and fill in. Never commit real secrets.

# SQLAlchemy URL (psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://studytrack:studytrack@localhost:5432/studytrack

# JWT signing — generate a strong random secret for any real deployment.
JWT_SECRET=dev-insecure-change-me
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Background reminder scanner interval, in seconds (Phase 5 realtime). Default 60.
REMINDER_SCAN_SECONDS=60

# --- Email (Phase 6) ---
# console = log the verify/reset link to stdout (dev default, no real delivery).
# smtp    = send via the stdlib smtplib using the EMAIL_SMTP_* settings below.
EMAIL_BACKEND=console            # console | smtp
EMAIL_FROM="StudyTrack <no-reply@studytrack.app>"
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
# Public base URL of the frontend, used to build verify/reset links in emails.
FRONTEND_URL=http://localhost:5173
# Single-use token lifetimes (hours).
EMAIL_VERIFY_TTL_HOURS=48
PASSWORD_RESET_TTL_HOURS=1

# --- Rate limiting (Phase 6) ---
# slowapi throttling on public auth endpoints. Disabled automatically in tests.
RATE_LIMIT_ENABLED=true
