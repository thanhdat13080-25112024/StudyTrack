# Copy to .env and fill in. Never commit real secrets.

# SQLAlchemy URL (psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://studytrack:studytrack@localhost:5432/studytrack

# JWT signing — generate a strong random secret for any real deployment.
JWT_SECRET=dev-insecure-change-me
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Background reminder scanner interval, in seconds (Phase 5 realtime). Default 60.
REMINDER_SCAN_SECONDS=60
