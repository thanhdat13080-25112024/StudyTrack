# =============================================================================
# StudyTrack .gitignore
# Only source + config belong in git. Never commit generated, installed, or
# local-only files. (See .claude/skills/studytrack-devops/SKILL.md)
# =============================================================================

# -----------------------------------------------------------------------------
# AI assistant tooling & guidance — kept LOCAL ONLY (untracked, not pushed)
# -----------------------------------------------------------------------------
# The Claude Code harness (agents + skills + settings) and the AI-instruction
# files live on disk but are intentionally untracked to keep the public repo
# product-only (solo project). GEMINI.md/GEMINI-VIE.md were removed (unused).
.claude/
CLAUDE.md
CLAUDE-VIE.md
GEMINI.md
GEMINI-VIE.md
# Superpowers workflow artifacts (per-phase specs & plans)
docs/superpowers/
# Harness cross-agent scratch (never pushed)
_workspace/

# -----------------------------------------------------------------------------
# Python (backend/)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# -----------------------------------------------------------------------------
# Node / Vite (frontend/)
# -----------------------------------------------------------------------------
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
coverage/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# NOTE: do NOT ignore frontend/src/lib/api-types.ts — it is generated by
# `make gen-types` but committed so the FE builds without booting the BE.
!frontend/src/lib/api-types.ts

# -----------------------------------------------------------------------------
# Env & secrets
# -----------------------------------------------------------------------------
.env
.env.*
# ...but keep the committed template:
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
secrets.*
# certbot / Let's Encrypt live certs (issued on the VPS, never committed)
deploy/certbot/

# -----------------------------------------------------------------------------
# Database / data / backups
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sql
# local Postgres data volumes mounted under the repo, if any
pgdata/
postgres-data/

# -----------------------------------------------------------------------------
# Editor / OS
# -----------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
